# Firebase web app (Project settings → General → Your apps → Web app). These are public by design.
# Without them the app runs in guest mode: everything works on the device, sign-in and sync are off.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SECRET. Service account JSON (Project settings → Service accounts → Generate new private key),
# pasted as one line. Only the server uses it. Never commit it or put it in a NEXT_PUBLIC_ variable.
FIREBASE_SERVICE_ACCOUNT=
