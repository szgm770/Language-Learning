{
  "name": "language-learning",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm content:build && pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "content:build": "pnpm --filter @lingo/content-schema build-content",
    "check": "pnpm typecheck && pnpm test && pnpm content:build",
    "test:emulator": "vitest run apps/web/src/server/emulator"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "firebase-tools": "^15.34.2"
  }
}
